APP_ENV=development
# disabled | test | x402-testnet | x402-mainnet
PAYMENT_MODE=disabled
PRICE_USD=0.05
# Endereço Algorand Testnet que recebe os pagamentos (obrigatório em x402-testnet).
PAY_TO=
X402_NETWORK=testnet
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
# Required only for the explicit x402-mainnet profile. Never enable by default.
ENABLE_MAINNET_X402=false
# stub | alpha_hunter
INTELLIGENCE_PROVIDER=stub
AHX_BRIDGE_URL=http://127.0.0.1:8787
# Required only when INTELLIGENCE_PROVIDER=alpha_hunter. Do not commit a real token.
AHX_BRIDGE_SERVICE_TOKEN=
AHX_BRIDGE_TIMEOUT_SECONDS=3
# Required in production. Comma-separated explicit https origins; never use *.
PUBLIC_BASE_URL=
CORS_ALLOW_ORIGINS=

# Free /v1/token/preview endpoint: response cache (not quota enforcement).
PREVIEW_CACHE_TTL_SECONDS=60

# Persistent, atomic preview quota + server-issued API keys (app/quota.py).
# ":memory:" (default) = NOT persisted across a restart/redeploy -- set a
# real file path (a Railway volume or equivalent) in production.
QUOTA_DB_PATH=:memory:
# Both unset by default = trust nothing but the raw transport-level peer
# address. Setting TRUSTED_PROXY_HEADER without TRUSTED_PROXY_CIDRS is a
# ConfigError at startup: a header NAME alone does not stop a client from
# sending it itself. Only set both once Railway's actual edge IP ranges
# for this deployment have been confirmed.
TRUSTED_PROXY_HEADER=
TRUSTED_PROXY_CIDRS=
# HMAC secret for pseudonymizing client IPs before they become a quota
# subject_id. Recommended in production; falls back to unsalted SHA-256
# (still not the raw IP, but guessable) if unset.
QUOTA_IP_PSEUDONYMIZATION_SALT=
# Retention: telemetry rows older than this are purged periodically (see
# app/retention.py). Quota buckets keep no history beyond the current
# minute/day regardless -- a past bucket has no future enforcement value.
TELEMETRY_RETENTION_DAYS=90
RETENTION_PURGE_INTERVAL_SECONDS=3600
# Pilot defaults -- not final policy.
QUOTA_ANONYMOUS_PER_MINUTE=10
QUOTA_ANONYMOUS_PER_DAY=50
QUOTA_ANONYMOUS_DISTINCT_MINTS_PER_DAY=15
QUOTA_REGISTERED_PER_MINUTE=30
QUOTA_REGISTERED_PER_DAY=300
QUOTA_REGISTERED_DISTINCT_MINTS_PER_DAY=60

# Cost/revenue telemetry (app/telemetry.py). Nothing here enables new
# Helius calls; it only prices attempts that a future feature records.
# Leave HELIUS_DAILY_BUDGET_CREDITS / HELIUS_PER_QUERY_CREDIT_LIMIT unset
# for "no cap configured yet".
HELIUS_DAILY_BUDGET_CREDITS=
HELIUS_PER_QUERY_CREDIT_LIMIT=
# Leave unset (default: unconfigured). A positive credit count with no
# configured rate is priced as UNKNOWN, never silently as 0. Set an
# explicit value (0 is a valid explicit choice) only once verified.
HELIUS_CREDIT_COST_USD=
# ":memory:" (default) = not persisted. Set an explicit file path (always
# separate from the Alpha Hunter intelligence database) to persist across
# restarts, e.g. a Railway volume mount.
TELEMETRY_DB_PATH=:memory:

# Paid-evidence quality gate (app/quality.py). A Mainnet sale requires at
# least one evidence item with a valid Solana tx signature, linked to the
# requested mint, whose on-chain block_time is at most this many seconds
# old by THIS server's clock (independent of the bridge's own FRESH label).
PAID_EVIDENCE_MAX_AGE_SECONDS=86400
# Market caps above this (USD) are treated as anomalous and removed.
MAX_MARKETCAP_USD=100000000000
# Premium sales switch (fail-closed). Only an explicit "true" lets
# POST /v1/token/investigate offer, verify, settle or produce intelligence.
# Unset/anything else = maintenance (503 premium_maintenance, no charge,
# no premium content, public routes unaffected). Never use
# PAYMENT_MODE=disabled to suspend sales: that mode serves premium for free.
PREMIUM_SALES_ENABLED=false
